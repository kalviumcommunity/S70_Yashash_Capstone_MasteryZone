# Mastery Zone Environment Configuration Template
# Copy this file to .env and fill in your values for local or production deployment.
# Never commit the actual .env file or production secrets to source control.

# Application Server
PORT=5012
# Set to 'development' for local development (enables localhost CORS & local process execution)
# Set to 'production' for deployed cloud instances (requires Judge0 remote execution for security)
NODE_ENV=development
ALLOW_LOCAL_CODE_EXECUTION=true

# Database Connection (Treat credentials as sensitive and rotate immediately if exposed)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/masteryzone?retryWrites=true&w=majority
# Local fallback:
# MONGODB_URI=mongodb://127.0.0.1:27017/masteryzone

# Public Frontend Client Application URL (Used in password reset links and emails)
# Set this to your frontend deployment domain (e.g. https://mastery-zone.vercel.app), NOT the backend Render service!
CLIENT_URL=https://mastery-zone.vercel.app
FRONTEND_URL=https://mastery-zone.vercel.app

# JWT Authentication Secret (Required in production - use a cryptographically strong 256-bit key)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Super Admin Account Configuration
MAIN_ADMIN_EMAIL=yashashyashash1@gmail.com
ADMIN_EMAIL=yashashyashash1@gmail.com
ADMIN_PASSWORD=change_this_default_admin_password_in_production

# ==============================================================================
# SMTP & CLOUD TRANSACTIONAL EMAIL CONFIGURATION
# ==============================================================================
# Mastery Zone supports both standard SMTP and HTTPS REST APIs (Port 443).
#
# NOTE FOR RENDER FREE TIER:
# Render actively blocks outbound TCP traffic on SMTP ports 25, 465, and 587
# on all free instances. If deploying on Render Free Tier:
# 1. Sign up at https://resend.com (free 3,000 emails/month).
# 2. Set RESEND_API_KEY=re_xxxx in your Render Environment variables.
# Mastery Zone will automatically route all emails over HTTPS Port 443,
# bypassing cloud host firewall restrictions completely!
#
RESEND_API_KEY=
RESEND_FROM="Mastery Zone" <onboarding@resend.dev>

# Standard Gmail SMTP configuration (Works locally, on VPS, or on paid cloud tiers):
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password under "App passwords":
#    Select App: "Mail", Device: "Other (Mastery Zone)"
#    IMPORTANT: Do NOT use your standard Google account login password.
# 3. Enter the 16-character password below (spaces are automatically removed).
#
# Port and Security details:
# - Port 465 (SSL/TLS direct): Set SMTP_SECURE=true
# - Port 587 (STARTTLS):       Set SMTP_SECURE=false
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM="Mastery Zone" <your_email@gmail.com>

# Firebase Admin SDK Configuration (for verified Google OAuth)
# Paste either service account JSON string or provide local path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT=

# Judge0 Execution Service (Optional - for high-security isolated compiler runs)
JUDGE0_API_HOST=
JUDGE0_API_KEY=

# SMS Service Configuration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
