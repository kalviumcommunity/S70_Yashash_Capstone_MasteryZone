# Mastery Zone Client Environment Configuration Template
# Copy this file to .env and fill in your values for local or production deployment.
# Never commit the actual .env file or production secrets to source control.

# Backend API & Socket.IO Server URL
# Local development: http://localhost:5012
# Production (Render): https://mastery-zone.onrender.com
VITE_API_URL=http://localhost:5012

# Firebase Web SDK Configuration (for Google OAuth Sign-In)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional Client-Side WebRTC TURN Server Fallback (Recommended to configure on backend via TURN_URLS instead)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
