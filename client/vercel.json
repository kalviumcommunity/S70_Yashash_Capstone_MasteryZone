{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://mastery-zone-api.onrender.com/api/$1" },
    { "source": "/auth/(.*)", "destination": "https://mastery-zone-api.onrender.com/auth/$1" },
    { "source": "/recordings/(.*)", "destination": "https://mastery-zone-api.onrender.com/recordings/$1" },
    { "source": "/certificates/(.*)", "destination": "https://mastery-zone-api.onrender.com/certificates/$1" },
    { "source": "/uploads/(.*)", "destination": "https://mastery-zone-api.onrender.com/uploads/$1" },
    { "source": "/proctoring-evidence/(.*)", "destination": "https://mastery-zone-api.onrender.com/proctoring-evidence/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
